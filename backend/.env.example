# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─────────────────────────────────────────────
# MongoDB
# ─────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/group-formation

# ─────────────────────────────────────────────
# CORS  (comma-separated allowed origins)
# ─────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
JWT_LIMITED_EXPIRES_IN=15m

# ─────────────────────────────────────────────
# Seed admin (used only on first boot)
# ─────────────────────────────────────────────
ADMIN_EMAIL=admin@groupformation.local
# Only used to CREATE the admin account when none exists yet — seedAdmin skips
# silently on every later boot. Changing this value here does NOT change the
# real account's password. If the admin's actual password is ever changed
# (via the app or a manual reset), update this value too so it stays accurate
# for disaster recovery — otherwise a future re-seed will silently diverge
# from whatever password is actually in use.
ADMIN_PASSWORD=Admin@123456
ADMIN_FULL_NAME=System Administrator

# ─────────────────────────────────────────────
# Groq (AI task generation — optional)
# ─────────────────────────────────────────────
GROQ_API_KEY=
